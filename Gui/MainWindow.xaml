<Window x:Class="StintTracker.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:StintTracker.Gui"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        FontSize="16"
        Background="#222222"
        Title="Stint Tracker" Height="190" Width="365">

    <DockPanel>
        <Grid Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">iRacing</Label>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="25,0,0,0">
                <Label VerticalAlignment="Center" x:Name="IracingStatusSymbol" Content="⬤" Foreground="Gray"/>
                <Label VerticalAlignment="Center" x:Name="IracingStatusLabel" Content="Starting..."/>
            </StackPanel>


            <Label Grid.Row="1" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">API</Label>

            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="25,0,0,0">
                <Label VerticalAlignment="Center" x:Name="ApiStatusSymbol" Content="⬤" Foreground="Gray"/>
                <Label VerticalAlignment="Center" x:Name="ApiStatusLabel" Content="Starting..."/>
            </StackPanel>


            <Label Grid.Row="2" Grid.Column="0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center">Tracker</Label>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="25,0,0,0">
                <Label VerticalAlignment="Center" x:Name="TrackerStatusSymbol" Content="⬤" Foreground="Gray"/>
                <Label VerticalAlignment="Center" x:Name="TrackerStatusLabel" Content="Starting..."/>
            </StackPanel>

        </Grid>
        
        <tb:TaskbarIcon x:Name="Taskbar"
            IconSource="pack://application:,,,/Gui\app.ico"
            ToolTipText="PDR Stint Tracker"
            MenuActivation="LeftOrRightClick">

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem  Header="Show/Hide" x:Name="ShowHideMenuItem" Click="ShowHideMenuItemOnClick" />
                    <MenuItem Header="Exit" x:Name="ExitMenuItem" Click="ExitMenuItemOnClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </DockPanel>

    
</Window>
